# Optional: only used when Gemini selection is explicitly chosen.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=45
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RETENTION_HOURS=168
# STORAGE_DIR=/absolute/path/to/persistent/storage
# FRONTEND_DIST=/absolute/path/to/Question-generation-project-integrated-frontend/dist
# Local OCR: install Tesseract and the required language data first.
TESSERACT_CMD=tesseract
OCR_LANGUAGE=eng
